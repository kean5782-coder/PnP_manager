<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvFeedbackTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Обратная связь и баг-репорт"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvFeedbackSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Отчёт будет отправлен автору: kean5782@yandex.ru"
            android:textColor="#AAAAAA"
            android:textSize="12sp" />

        <!-- Barcode Code Box (if present) -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilReportCode"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:hint="Нераспознанный код / артикул"
            android:textColorHint="#AAAAAA"
            app:boxStrokeColor="@color/accent">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etReportCode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- User Note Input -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilReportNotes"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="Описание (производитель, номинал, что произошло)"
            android:textColorHint="#AAAAAA"
            app:boxStrokeColor="@color/accent">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etReportNotes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="top"
                android:inputType="textMultiLine"
                android:lines="3"
                android:maxLines="5"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Info Note -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="ℹ️ К письму автоматически прикрепятся системные логи и модель устройства для быстрой диагностики."
            android:textColor="#888888"
            android:textSize="11sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:text="@string/created_with_gemini"
            android:textColor="#66FFFFFF"
            android:textSize="11sp" />

    </LinearLayout>
</ScrollView>
