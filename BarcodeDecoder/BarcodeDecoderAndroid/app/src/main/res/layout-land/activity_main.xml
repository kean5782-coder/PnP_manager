<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mainContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- Camera Preview View -->
    <androidx.camera.view.PreviewView
        android:id="@+id/previewView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/rightControlsLayout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:scaleType="fillCenter" />

    <!-- Frozen Frame View for Freeze-Frame Intensive Scan and Gallery Photo View -->
    <ImageView
        android:id="@+id/ivFrozenFrame"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="fitCenter"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/rightControlsLayout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Interactive Overlay for viewfinder ROI and detected bounding boxes -->
    <com.barcodedecoder.ui.ScannerOverlayView
        android:id="@+id/scannerOverlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/rightControlsLayout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Top Header Bar (Manual Input & Info / Help) -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="#80000000"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp"
        app:layout_constraintEnd_toStartOf="@id/rightControlsLayout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tvAppTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:singleLine="true"
            android:text="@string/app_name"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnManualInput"
            style="@style/Widget.Material3.Button.IconButton.Filled.Tonal"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginEnd="8dp"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:padding="0dp"
            app:iconSize="22dp"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            android:focusable="true"
            android:clickable="true"
            android:contentDescription="@string/manual_input"
            app:tooltipText="@string/manual_input"
            android:nextFocusRight="@id/btnInfo"
            android:nextFocusDown="@id/btnCapture"
            app:strokeColor="@color/btn_focus_stroke"
            app:strokeWidth="2dp"
            app:icon="@drawable/ic_keyboard_input"
            app:iconTint="#FFFFFF" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnInfo"
            style="@style/Widget.Material3.Button.IconButton.Filled.Tonal"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:padding="0dp"
            app:iconSize="22dp"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            android:focusable="true"
            android:clickable="true"
            android:contentDescription="@string/info_button"
            app:tooltipText="@string/info_button"
            android:nextFocusLeft="@id/btnManualInput"
            android:nextFocusRight="@id/btnFlashlight"
            app:strokeColor="@color/btn_focus_stroke"
            app:strokeWidth="2dp"
            app:icon="@drawable/ic_info"
            app:iconTint="#FFFFFF" />
    </LinearLayout>

    <!-- Scanning status / hint badge -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginHorizontal="24dp"
        app:cardBackgroundColor="#CC1E1E24"
        app:cardCornerRadius="16dp"
        app:cardElevation="4dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toStartOf="@id/rightControlsLayout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:strokeColor="#33FFFFFF"
        app:strokeWidth="1dp">

        <TextView
            android:id="@+id/tvStatusHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp"
            android:text="@string/scanning_hint"
            android:textColor="#FFFFFF"
            android:textSize="12sp" />
    </com.google.android.material.card.MaterialCardView>

    <!-- Scan Again Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnScanAgain"
        style="@style/Widget.Material3.Button.ElevatedButton"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:layout_marginBottom="16dp"
        android:focusable="true"
        android:clickable="true"
        android:text="@string/scan_again"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:visibility="gone"
        app:backgroundTint="@color/primary"
        app:cornerRadius="22dp"
        app:strokeColor="@color/btn_focus_stroke"
        app:strokeWidth="2dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/rightControlsLayout"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Right Vertical Control Panel: 3 Large Controls (Landscape) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/rightControlsLayout"
        android:layout_width="100dp"
        android:layout_height="0dp"
        android:background="#99000000"
        android:paddingVertical="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- 1. Top Right: Flashlight Button -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/btnFlashlight"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@string/flashlight_button"
            app:cardBackgroundColor="#33FFFFFF"
            app:cardCornerRadius="28dp"
            app:cardElevation="6dp"
            app:strokeColor="@color/btn_focus_stroke"
            app:strokeWidth="2dp"
            android:nextFocusLeft="@id/btnInfo"
            android:nextFocusDown="@id/btnCapture"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/ivFlashlightIcon"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_flashlight"
                app:tint="#FFFFFF"
                android:contentDescription="@string/flashlight_button" />
        </com.google.android.material.card.MaterialCardView>

        <!-- 2. Middle Right: High-Res Capture Shutter Button -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/btnCapture"
            android:layout_width="76dp"
            android:layout_height="76dp"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@string/capture_button"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="38dp"
            app:cardElevation="10dp"
            app:strokeColor="@color/accent"
            app:strokeWidth="3dp"
            android:nextFocusUp="@id/btnFlashlight"
            android:nextFocusLeft="@id/scannerOverlay"
            android:nextFocusDown="@id/btnGallery"
            app:layout_constraintBottom_toTopOf="@id/btnGallery"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btnFlashlight">

            <ImageView
                android:id="@+id/ivCaptureIcon"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_capture"
                app:tint="#1E1E24"
                android:contentDescription="@string/capture_button" />
        </com.google.android.material.card.MaterialCardView>

        <!-- 3. Bottom Right: Gallery with thumbnail preview -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/btnGallery"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@string/gallery_button"
            app:cardBackgroundColor="#33FFFFFF"
            app:cardCornerRadius="28dp"
            app:cardElevation="6dp"
            app:strokeColor="@color/btn_focus_stroke"
            app:strokeWidth="2dp"
            android:nextFocusUp="@id/btnCapture"
            android:nextFocusLeft="@id/scannerOverlay"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <ImageView
                    android:id="@+id/ivGalleryThumb"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:contentDescription="@string/gallery_button" />

                <ImageView
                    android:id="@+id/ivGalleryIcon"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_gallery"
                    app:tint="#FFFFFF"
                    android:contentDescription="@string/gallery_button" />
            </FrameLayout>
        </com.google.android.material.card.MaterialCardView>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Permission Request Overlay -->
    <LinearLayout
        android:id="@+id/layoutPermission"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#E6121212"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/camera_permission_required"
            android:textColor="#FFFFFF"
            android:textSize="16sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGrantPermission"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:focusable="true"
            android:clickable="true"
            app:strokeColor="@color/btn_focus_stroke"
            app:strokeWidth="2dp"
            android:text="@string/grant_permission" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
